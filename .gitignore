# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-mcp
/.playwright-mcp

# LaTeX CV build artifacts (generated by Makefile / local builds)
/assets/cv/*.aux
/assets/cv/*.log
/assets/cv/*.out
/assets/cv/*.bcf
/assets/cv/*.blg
/assets/cv/*.bbl
/assets/cv/*.run.xml
/assets/cv/*.pdf
/assets/cv/*-vi-xelatex.tex
/assets/cv/*-vi-xelatex.pdf
/assets/cv/*.synctex.gz
/assets/cv/*.toc
# temporary LaTeX files
/assets/cv/*~
# LaTeX helper files (latexmk, etc.)
*.cut
*.fdb
*.fdb_latexmk
*.fls
*.bbl-SAVE-ERROR
*.bcf-SAVE-ERROR